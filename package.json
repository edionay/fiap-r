{
  "name": "vehicle-management-api",
  "version": "0.1.0",
  "private": true,
  "description": "API para gestão do catálogo e das vendas de veículos.",
  "main": "dist/config/server.js",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "dev": "npm run generate:routes && tsx watch src/config/server.ts",
    "generate": "tsoa spec-and-routes",
    "generate:routes": "tsoa routes",
    "generate:spec": "tsoa spec",
    "lint": "eslint .",
    "start": "node dist/config/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run generate:routes && tsc --noEmit"
  },
  "dependencies": {
    "@tsoa/runtime": "6.6.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsoa/cli": "6.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.12.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "ts-deepmerge": "8.0.0"
  }
}
