{
  "name": "api-gerenciamento-veiculos",
  "version": "0.1.0",
  "private": true,
  "description": "API para gestão do catálogo e das vendas de veículos.",
  "main": "dist/config/server.js",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations",
    "db:migrate:dev": "node-pg-migrate up --migrations-dir migrations --envPath .env",
    "db:migrate:down:dev": "node-pg-migrate down --migrations-dir migrations --envPath .env",
    "dev": "npm run generate && node --env-file=.env --watch --import tsx src/config/server.ts",
    "generate": "tsoa spec-and-routes",
    "generate:routes": "tsoa routes",
    "generate:spec": "tsoa spec",
    "lint": "eslint .",
    "start": "node dist/config/server.js",
    "test": "vitest run",
    "test:integration:database": "vitest run tests/integration/postgres",
    "test:watch": "vitest",
    "typecheck": "npm run generate:routes && tsc --noEmit"
  },
  "dependencies": {
    "@tsoa/runtime": "6.6.0",
    "express": "^5.2.1",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsoa/cli": "6.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "ts-deepmerge": "8.0.0"
  }
}
